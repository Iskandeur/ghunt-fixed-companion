{
  "manifest_version": 3,
  "name": "ghunt-fixed Companion",
  "short_name": "ghunt-fixed",
  "version": "1.0.0",
  "description": "Log GHunt / ghunt-fixed in to Google in one click: fetches a fresh, single-use oauth_token and hands it to GHunt. Never caches it.",
  "homepage_url": "https://github.com/Iskandeur/ghunt-fixed-companion",
  "permissions": ["cookies", "storage", "tabs"],
  "host_permissions": ["https://accounts.google.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "browser_specific_settings": {
    "gecko": {
      "id": "ghunt-fixed-companion@iskandeur",
      "strict_min_version": "115.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
